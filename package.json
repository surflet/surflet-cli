{
  "name": "surflet-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.13" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "build": "pnpm -r --sort build",
    "build:contracts": "pnpm --filter @surflet/core --filter @surflet/connector build",
    "typecheck": "pnpm build:contracts && pnpm -r --sort typecheck",
    "lint": "eslint apps packages --max-warnings 0",
    "test": "pnpm build:contracts && vitest run",
    "surflet": "node apps/connector/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.2.6"
  }
}
